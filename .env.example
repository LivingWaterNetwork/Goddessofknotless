# ---------------------------------------------------------------------------
# Goddess of Knotless — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# ---------------------------------------------------------------------------

# Canonical site origin, used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://goddessofknotless.com

# The booking destination. Every "Reserve"/"Book" button on the site reads this
# one value, so switching platforms needs no code change. Until it is set, all
# booking buttons render disabled rather than as dead links.
# See docs/BOOKING_PLATFORM_SCORECARD.md for the platform recommendation.
NEXT_PUBLIC_BOOKING_URL=

# Optional deep link for returning clients ("Rebook in one tap"). Leave blank
# if the chosen platform has no such link; the control hides itself.
NEXT_PUBLIC_REBOOK_URL=

# "preview" (default) renders internal verification labels on unconfirmed
# content. "production" hides them AND makes `pnpm content:check` a hard gate.
NEXT_PUBLIC_CONTENT_MODE=preview

# Vercel Web Analytics + Speed Insights. Off by default; requires Esther's
# approval before enabling.
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Search engine indexing. Leave UNSET for review and preview deployments — a
# shareable review URL that Google can crawl would index placeholder
# photography, unconfirmed prices, and disabled booking buttons, and would then
# compete with the real site at launch.
#
# Set to "true" only on the production deployment of the real custom domain.
# Until then robots.txt disallows everything and every page carries noindex.
NEXT_PUBLIC_ALLOW_INDEXING=
